{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run check:vercel && PORT=20943 BASE_PATH=/ pnpm --filter @workspace/lavallee-construction run build",
  "outputDirectory": "artifacts/lavallee-construction/dist/public",
  "functions": {
    "api/quotes.ts": { "maxDuration": 45 }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/soumission/index.html", "destination": "/soumission", "permanent": true },
    { "source": "/politique-de-confidentialite/index.html", "destination": "/politique-de-confidentialite", "permanent": true }
  ],
  "rewrites": [
    { "source": "/soumission", "destination": "/soumission/index.html" },
    { "source": "/soumission/", "destination": "/soumission/index.html" },
    { "source": "/politique-de-confidentialite", "destination": "/politique-de-confidentialite/index.html" },
    { "source": "/politique-de-confidentialite/", "destination": "/politique-de-confidentialite/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }]
    },
    {
      "source": "/images/optimized/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/photos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/certifications/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/404.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
